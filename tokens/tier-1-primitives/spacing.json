{
  "$schema": "https://tr.designtokens.org/format/",
  "spacing": {
    "gridBase": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "Core 8px grid unit"
    },
    "scale": {
      "0": { "$value": "0px", "$type": "dimension", "$description": "0px spacing" },
      "050": { "$value": "4px", "$type": "dimension", "$description": "4px - 0.5x grid unit (compact half-step)" },
      "100": { "$value": "8px", "$type": "dimension", "$description": "8px - 1x grid base unit" },
      "150": { "$value": "12px", "$type": "dimension", "$description": "12px - 1.5x grid unit" },
      "200": { "$value": "16px", "$type": "dimension", "$description": "16px - 2x grid unit" },
      "250": { "$value": "20px", "$type": "dimension", "$description": "20px - 2.5x grid unit" },
      "300": { "$value": "24px", "$type": "dimension", "$description": "24px - 3x grid unit" },
      "400": { "$value": "32px", "$type": "dimension", "$description": "32px - 4x grid unit" },
      "500": { "$value": "40px", "$type": "dimension", "$description": "40px - 5x grid unit" },
      "600": { "$value": "48px", "$type": "dimension", "$description": "48px - 6x grid unit" },
      "700": { "$value": "56px", "$type": "dimension", "$description": "56px - 7x grid unit" },
      "800": { "$value": "64px", "$type": "dimension", "$description": "64px - 8x grid unit" },
      "900": { "$value": "72px", "$type": "dimension", "$description": "72px - 9x grid unit" },
      "1000": { "$value": "80px", "$type": "dimension", "$description": "80px - 10x grid unit" },
      "1200": { "$value": "96px", "$type": "dimension", "$description": "96px - 12x grid unit" },
      "1600": { "$value": "128px", "$type": "dimension", "$description": "128px - 16x grid unit" }
    }
  }
}
