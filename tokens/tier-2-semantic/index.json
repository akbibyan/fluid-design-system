  "layout": {
    "space": {
      "layout": {
        "pageGutter": {
          "$value": "{spacing.scale.300}",
          "$type": "dimension",
          "$description": "Standard page outer horizontal gutter (24px)"
        },
        "sectionGap": {
          "$value": "{spacing.scale.800}",
          "$type": "dimension",
          "$description": "Vertical space between major page sections (64px)"
        },
        "containerPadding": {
          "$value": "{spacing.scale.400}",
          "$type": "dimension",
          "$description": "Standard container inner padding (32px)"
        }
      },
      "inset": {
        "xs": {
          "$value": "{spacing.scale.050}",
          "$type": "dimension",
          "$description": "Extra small inset padding (4px)"
        },
        "sm": {
          "$value": "{spacing.scale.100}",
          "$type": "dimension",
          "$description": "Small component inset padding (8px)"
